# Backend (default ports chosen to avoid common conflicts on this machine)
PORT=38471
NODE_ENV=development
CORS_ORIGIN=http://localhost:38472

# CelesTrak groups to fetch (comma-separated)
CELESTRAK_GROUPS=amateur,weather,cubesat,stations,active

# Cache refresh intervals (cron expressions)
TLE_REFRESH_CRON=0 */6 * * *
TRANSMITTER_REFRESH_CRON=0 3 * * *

# Optional SatNOGS API key (not required for read-only access)
SATNOGS_API_KEY=

# Frontend (Vite) — leave empty so /api is proxied (required for Tailscale/remote access)
VITE_API_URL=
